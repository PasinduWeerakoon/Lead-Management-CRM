# Copy to .env.local for local development, and set the same values in Vercel → Settings → Environment Variables.
# These are read only by the /api functions on the server — never sent to the browser.

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Without it the app works in this browser only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (default: leads).
MONGODB_DB=leads
# Shared workspace access code that protects the data (there's no login). Required on Vercel; optional locally.
APP_ACCESS_KEY=choose-a-long-random-code
