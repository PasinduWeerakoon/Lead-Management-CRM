# Copy to .env.local for local development, and set the same values in Vercel → Settings → Environment Variables.
# These are read only by the /api functions on the server — never sent to the browser.

# Shared database: pick ONE. DynamoDB is used when DATA_TABLE is set (the AWS setup).
#  - DynamoDB on AWS: DATA_TABLE=<table name> and AWS credentials (AWS_PROFILE / AWS_REGION)
#  - DynamoDB Local:  DATA_TABLE=leads-data and DYNAMODB_ENDPOINT=http://localhost:8000 (npm run db:local)
#  - No database, data kept in the dev server's memory until restart: DATA_STORE=memory
DATA_TABLE=
DYNAMODB_ENDPOINT=
DATA_STORE=
# MongoDB Atlas connection string (Atlas → Connect → Drivers). Without it the app works in this browser only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (default: leads).
MONGODB_DB=leads
# Google sign-in. Create an OAuth client (Web application) in Google Cloud Console and add your site
# (and http://localhost:5180 for local testing) under Authorized JavaScript origins.
# Required on Vercel. Locally, leave GOOGLE_CLIENT_ID empty to skip sign-in.
GOOGLE_CLIENT_ID=
# At least 32 random characters, used to sign the session cookie. Example: openssl rand -base64 48
SESSION_SECRET=
# Who may sign in: anyone on this Google Workspace domain, plus any extra emails (comma separated).
ALLOWED_DOMAIN=1billiontech.com
ALLOWED_EMAILS=
# Company OpenAI key, used only by /api/ai on the server; the browser never receives it.
OPENAI_API_KEY=
# Daily spending limit for the company key, in USD (resets at midnight Sri Lanka time).
AI_DAILY_CAP_USD=10
# Optional free data sources (server only).
# Adzuna job listings with salaries: free key at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Hunter.io work emails (free plan has a small monthly limit): hunter.io/api-keys
HUNTER_API_KEY=

# Coresignal: licensed people, company and job data. Server only, never sent to the browser.
CORESIGNAL_API_KEY=
