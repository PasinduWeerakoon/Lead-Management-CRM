    "dexie-react-hooks": "^4.4.0",
    "exceljs": "^4.4.0",
    "mongodb": "^6.21.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
